# Copy this file to .env.local and fill in the values (Supabase Dashboard > Project Settings > API).
# Restart `npm run dev` after changing them. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Needed to add, edit and remove staff logins (Settings > Staff and roles).
# This key bypasses all database security: never prefix it with NEXT_PUBLIC_, never put it in browser code,
# and never commit it. On Vercel add it under Settings > Environment Variables (Production and Preview).
SUPABASE_SERVICE_ROLE_KEY=
